<configure
    xmlns="http://namespaces.zope.org/zope"
    xmlns:zcml="http://namespaces.zope.org/zope"
    xmlns:browser="http://namespaces.zope.org/browser"
    xmlns:plone="http://namespaces.plone.org/plone"
    i18n_domain="eea.dataconnector">

    <include package="plone.restapi"  />

    <!-- Adapter for ConnectorData -->
    <adapter
        factory=".dataconnector.ConnectorData"
        provides="plone.restapi.interfaces.IExpandableElement"
        name="connector-data"
        for="eea.api.dataconnector.interfaces.IConnectorDataProvider
             zope.interface.Interface"
    />

    <adapter
        factory=".dataconnector.ConnectorData"
        provides="plone.restapi.interfaces.IExpandableElement"
        name="connector-data"
        for="eea.api.dataconnector.interfaces.IFileDataProvider
             zope.interface.Interface"
    />

    <!-- Adapter for ElasticConnectorData -->
    <adapter
        factory=".dataconnector.ElasticConnectorData"
        provides="plone.restapi.interfaces.IExpandableElement"
        name="connector-data"
        for="eea.api.dataconnector.interfaces.IElasticDataProvider
             zope.interface.Interface"
    />

    <!-- Plone services -->
    <plone:service
        method="GET"
        for="eea.api.dataconnector.interfaces.IConnectorDataProvider"
        factory=".dataconnector.ConnectorDataGet"
        name="@connector-data"
        permission="zope2.View"
    />

    <plone:service
        method="POST"
        for="eea.api.dataconnector.interfaces.IConnectorDataProvider"
        factory=".dataconnector.ConnectorDataPost"
        name="@connector-data"
        permission="zope2.View"
    />

    <plone:service
        method="GET"
        for="eea.api.dataconnector.interfaces.IFileDataProvider"
        factory=".dataconnector.ConnectorDataGet"
        name="@connector-data"
        permission="zope2.View"
    />

    <plone:service
        method="POST"
        for="eea.api.dataconnector.interfaces.IFileDataProvider"
        factory=".dataconnector.ConnectorDataPost"
        name="@connector-data"
        permission="zope2.View"
    />

    <plone:service
        method="GET"
        for="eea.api.dataconnector.interfaces.IElasticDataProvider"
        factory=".dataconnector.ConnectorDataGet"
        name="@connector-data"
        permission="zope2.View"
    />

    <plone:service
        method="POST"
        for="eea.api.dataconnector.interfaces.IElasticDataProvider"
        factory=".dataconnector.ConnectorDataPost"
        name="@connector-data"
        permission="zope2.View"
    />


  <!-- -*- extra stuff goes here -*- -->
</configure>
