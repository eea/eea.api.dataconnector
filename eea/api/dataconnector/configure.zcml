<configure
  xmlns="http://namespaces.zope.org/zope"
  xmlns:i18n="http://namespaces.zope.org/i18n"
  i18n_domain="eea"
>

  <i18n:registerTranslations directory="locales" />

  <adapter
    factory=".adapter.DataProviderForConnectors"
    provides=".interfaces.IDataProvider"
    name="connector" />
  <adapter
    factory=".adapter.DataQueryJsonSchemaProvider"
    name="data_query" />

  <!-- map_interactive preview images rendered by ArcGIS -->
  <subscriber
    for=".interfaces.IMaps
         zope.lifecycleevent.interfaces.IObjectAddedEvent"
    handler=".map_preview.on_added" />
  <subscriber
    for=".interfaces.IMaps
         zope.lifecycleevent.interfaces.IObjectModifiedEvent"
    handler=".map_preview.on_modified" />

  <include file="profiles.zcml" />
  <include file="permissions.zcml" />
  <include file="behavior.zcml" />
  <include package=".api" />
  <include package=".browser" />
  <include package=".upgrades" />

</configure>